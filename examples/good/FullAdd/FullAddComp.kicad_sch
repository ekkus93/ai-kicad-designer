	(text ".control\nset controlswait\nset mypath =\"D:/Spice_general/KiCad-800/FullAdd/\" ; <------------------------ Edit!\nif $?sharedmode\n  version -s\nelse\n  * for use with standard ngspice only\n  tran 1n 3.6u\nend\nrusage time\nedisplay\n*\n* save data to vcd file in directory given above\neprvcd /a3 /a2 /a1 /a0 /b3 /b2 /b1 /b0 \n+ /c0cin /s1_283 /s2_283 /s3_283 /s4_283 /c4_283\n+ /S1_and /S2_and /S3_and /S4_and /C4_and\n+ > {$mypath}adder-283.vcd\n*\n* plotting the vcd file with GTKWave, using script nggtk.tcl\nif $oscompiled = 1 | $oscompiled = 8  ; MS Windows\n  shell start gtkwave {$mypath}adder-283.vcd --script {$mypath}nggtk.tcl\nelse\n  if $oscompiled = 7 ; macOS, manual tweaking required (mark, insert, Zoom Fit)\n    shell open -a gtkwave {$mypath}adder-283.vcd\n  else ; Linux and others\n    shell gtkwave {$mypath}adder-283.vcd --script {$mypath}nggtk.tcl &\n  end\nend\n.endc\n"
		(exclude_from_sim no)
